{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:autocad-community-description-record:2.0.0",
  "title":"AutoCAD community purpose-description record",
  "type":"object","additionalProperties":false,
  "required":["lifecycle_id","type","name","description_status","descriptions","related_items"],
  "properties":{
    "lifecycle_id":{"type":"string","pattern":"^(cmd|sysvar)-[0-9]{4}$"},
    "type":{"enum":["command","system_variable"]},
    "name":{"type":"string","minLength":1},
    "description_status":{"enum":["matched","not_found","ambiguous"]},
    "descriptions":{"type":"array","items":{"$ref":"#/$defs/description"}},
    "related_items":{"type":"array","items":{"$ref":"#/$defs/related"}}
  },
  "$defs":{
    "description":{"type":"object","additionalProperties":false,"required":["source","url","matched_name","text"],"properties":{"source":{"enum":["cadforum","manusoft","hyperpics","other"]},"url":{"type":"string","format":"uri"},"matched_name":{"type":"string","minLength":1},"text":{"type":"string","minLength":1}}},
    "related":{"type":"object","additionalProperties":false,"required":["name","type","relation","source_url","evidence_text"],"properties":{"name":{"type":"string"},"type":{"enum":["command","system_variable"]},"relation":{"enum":["controlled_command","command_counterpart","related_command","related_system_variable"]},"source_url":{"type":"string","format":"uri"},"evidence_text":{"type":"string"}}}
  }
}
